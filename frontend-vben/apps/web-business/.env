# Public browser build settings. Do not put credentials in VITE_* variables.
VITE_APP_TITLE=QueryX
# Use a QueryX-specific namespace so browsers cannot restore retired branding
# from an older local preference cache.
VITE_APP_NAMESPACE=queryx-business-v1
VITE_APP_STORE_SECURE_KEY=PUBLIC_BROWSER_CACHE_NAMESPACE_ONLY
